  "info": {
    "_postman_id": "aea8c7dc-ebfd-406e-8706-eb12227c05ce",
    "name": "HPE GreenLake Authorization Identity API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Unified REST API gateway for HPE GreenLake edge-to-cloud services\ndocumented at developer.greenlake.hpe.com. Covers identity (user\nmanagement), API client credentials, workspaces, and authorization\n(scope groups and role assignments). Conforms to OpenAPI 3.0 and\nauthenticates with OAuth 2.0 client credentials that issue\nshort-lived JWT bearer tokens.\n\n\nContact Support:\n Name: HPE GreenLake Developer",
      "type": "text/plain"
    }
  }
